# Replace these three local demo values with random hex strings (openssl rand -hex 24).
POSTGRES_PASSWORD=change-this-local-postgres-password
API_KEY=change-this-local-admin-api-key
INGESTION_API_KEY=change-this-local-ingestion-key

AI_PROVIDER=demo
ALLOW_EXTERNAL_AI=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Compose overrides DB and Redis URLs with its internal service addresses.
# Set these manually for a native development environment.
# DATABASE_URL=postgresql://assistant:password@127.0.0.1:5432/assistant
# REDIS_URL=redis://127.0.0.1:6379/0
